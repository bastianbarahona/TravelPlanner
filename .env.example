# Copy to .env to override. docker compose uses these same values as defaults.
MOCK_PORT=4010

# Comma-separated token:caller pairs. Bookings, references and keys are scoped to the caller.
MOCK_TOKENS=travel-demo-token:travel-app

MOCK_QUOTE_TTL_SECONDS=900
MOCK_SUPPLIER_DEADLINE_SECONDS=5
MOCK_PENDING_DELAY_SECONDS=5

# Test environments only. 1 exposes /__control. Application workflows never use it.
MOCK_CONTROL_ENABLED=0

APP_PORT=8000

# Comma-separated token:userId pairs. These are the test identities: there is no users table.
APP_TOKENS=token-ana:ana,token-ben:ben,token-cam:cam,token-dee:dee

# The token the application sends to the provider. It must be one of the tokens in MOCK_TOKENS.
# Compose sets PROVIDER_BASE_URL itself (http://provider-mock:4010/v1, with /v1). Outside compose it is required too.
PROVIDER_TOKEN=travel-demo-token

# Seconds the application waits for one provider call, in total. It must exceed MOCK_SUPPLIER_DEADLINE_SECONDS,
# so a slow supplier shows up as a warning and not as a timeout (A43).
PROVIDER_TIMEOUT_SECONDS=10

# Compose sets APP_DATABASE_URL for the db service. Set it yourself only to run the app outside compose,
# for example postgresql+psycopg://travel:travel@localhost:5432/travel
# APP_DATABASE_URL=
