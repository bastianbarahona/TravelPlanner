# Copy to .env to override. docker compose uses these same values as defaults.
MOCK_PORT=4010

# Comma-separated token:caller pairs. Bookings, references and keys are scoped to the caller.
MOCK_TOKENS=travel-demo-token:travel-app

MOCK_QUOTE_TTL_SECONDS=900
MOCK_SUPPLIER_DEADLINE_SECONDS=5
MOCK_PENDING_DELAY_SECONDS=5

# Test environments only. 1 exposes /__control. Application workflows never use it.
MOCK_CONTROL_ENABLED=0
